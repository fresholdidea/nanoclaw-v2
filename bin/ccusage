#!/usr/bin/env bash
#
# ccusage — run the installed ccusage binary with NanoClaw provider data.
#
# Resolve the checkout from this script so it works when called from anywhere:
#   ln -s "$(pwd)/bin/ccusage" ~/.local/bin/ccusage-nanoclaw
#
set -euo pipefail

SCRIPT="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT" ]; do
  DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ "$SCRIPT" != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"
exec pnpm exec tsx src/ccusage.ts "$@"
