+    fs.mkdirSync(hostRoot, { recursive: true });
+
+    await runMigrations(await initTestDb());
+    await createAgentGroup({ id: GID, name: 'm', folder: 'm', agent_provider: null, created_at: now() });
+    await ensureContainerConfig(GID);
