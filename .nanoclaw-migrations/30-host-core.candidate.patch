+interface OutboundFileStats {
+  mtimeMs: number;
+  size: number;
+  /** MAX(messages_out.timestamp) — null for an empty table. */
+  lastAt: string | null;
+  /** `channel_type='agent'` rows newer than the cutoff at scan time. */
+  agentRows: Array<{ ts: string; to: string }>;
